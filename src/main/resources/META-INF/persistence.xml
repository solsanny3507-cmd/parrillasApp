<?xml version="1.0" encoding="UTF-8" ?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="EpmmopPU" transaction-type="JTA">
        <jta-data-source>java:/bd_postgres_epmmop</jta-data-source>
        <exclude-unlisted-classes>false</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
            <property name="hibernate.jpa.compliance.transaction" value="false"/>
        </properties>
    </persistence-unit>
    <persistence-unit name="OraclePU" transaction-type="JTA">
        <jta-data-source>java:/bd_oracle</jta-data-source>
        <exclude-unlisted-classes>false</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
            <property name="hibernate.jpa.compliance.transaction" value="false"/>
        </properties>
    </persistence-unit>
</persistence>